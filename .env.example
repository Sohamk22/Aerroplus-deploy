# ==============================================================================
# AeroPlus Public Web App — Environment Configuration (Vercel & Local)
#
# INSTRUCTIONS:
# 1. For local development: copy this file to `.env.local`
#    cp .env.example .env.local
# 2. For Vercel production: add these variables in your Vercel Project Dashboard:
#    Project Settings -> Environment Variables
#
# NOTE: The application includes a verified deterministic offline intelligence
# engine and will function completely even if API keys are left blank!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Conversational Intelligence & Reasoning)
# Powers natural-language dialogue, query intent understanding, and personalized advice.
# Get a free key at: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 2. Google Air Quality API (Optional Live Atmospheric Fallback)
# Note: Real-time observations already work out-of-the-box via Open-Meteo.
# ------------------------------------------------------------------------------
GOOGLE_AIR_QUALITY_API_KEY=your_google_air_quality_api_key_here
